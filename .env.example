# Redis Configuration (Upstash)
UPSTASH_REDIS_URL=redis://default:YOUR_PASSWORD@redis-xxxxx.cloud.redislabs.com:xxxxx

# Supabase Configuration (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ============================================================================
# LLM PROVIDER CONFIGURATION - Elige UNO de estos:
# ============================================================================
# Opciones: openai, huggingface, gemini, llama3
LLM_PROVIDER=openai

# OpenAI Configuration (Recomendado - Rápido y confiable)
OPENAI_API_KEY=sk-proj-your_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# HuggingFace Configuration (Alternativa gratis + LoRA)
# Obtén tu token en: https://huggingface.co/settings/tokens
# Acepta licencias en:
#   - https://huggingface.co/meta-llama/Llama-3.2-3B-Instruct
#   - https://huggingface.co/meta-llama/Llama-3.2-1B-Instruct (para LoRA)
HUGGINGFACE_TOKEN=hf_your_token_here
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-1B-Instruct

# Google Gemini Configuration (Gratis - Muy bueno)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3-pro-preview
# Alternativas: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp

# Llama 3 Local Configuration (Requiere GPU + 10GB espacio)
# LLAMA3_MODEL_PATH=meta-llama/Llama-3.2-3B-Instruct
# LLAMA3_USE_GPU=true

# ============================================================================
# EMBEDDINGS CONFIGURATION
# ============================================================================
# Opciones: openai, huggingface
EMBEDDING_PROVIDER=openai

# OpenAI Embeddings (Recomendado - Mejor calidad)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# HuggingFace Embeddings (Alternativa gratis)
# EMBEDDING_MODEL_HF=BAAI/bge-small-en-v1.5
# EMBEDDING_DIMENSIONS_HF=384

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# ============================================================================
# PRESENTATION SETTINGS
# ============================================================================
# Generar imágenes con DALL-E en presentaciones (usa OPENAI_API_KEY)
USE_DALLE_IMAGES=true

# Modelo de DALL-E a usar:
# - dall-e-2: Más barato ($0.018/imagen), calidad media, a veces no entiende bien el contexto
# - dall-e-3: Más caro ($0.040/imagen), MUCHO mejor calidad y comprensión del contexto
DALLE_MODEL=dall-e-3

# Costos por presentación de 5 slides (3 imágenes):
# - DALL-E 2: $0.054 USD
# - DALL-E 3: $0.120 USD
